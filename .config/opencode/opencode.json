{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-notify"],
  "permission": {
    "read": {
      "**/*":"allow",
      "!.env": "deny",
      "!.env.*": "deny"
    },
    "glob": "allow",
    "grep": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny"
    },
    "bash": {
      "ls *": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git ref*": "allow",
      "git log*": "allow",
      "find *": "allow",
      "head *": "allow",
      "sort *": "allow",
      "cat *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "xrandr *": "allow",
      "pactl info": "allow",
      "pactl list-*": "allow",
      "pw-metadata *": "allow",
      "pw-cli *": "allow",
      "wpctl *": "allow",
      "picom *": "allow",
      "lspci *": "allow",
      "lsusb": "allow",
      "journalctl *": "allow",
      "dmesg *": "allow",
      "ps *": "allow",
      "pgrep *": "allow",
      "pidof *": "allow",
      "uname *": "allow",
      "nvidia-smi": "allow",
      "nvidia-settings --query*": "allow",
      "fc-list *": "allow",
      "df *": "allow",
      "free *": "allow",
      "lsmod": "allow",
      "playerctl *": "allow",
      "env": "allow",
      "which *": "allow",
      "command -v *": "allow",
      "echo *": "allow"
    },
    "skill": "allow",
    "todowrite": "allow"
  }
}
{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-notify"],
  "permission": {
    "read": {
      "**/*":"allow",
      "!.env": "deny",
      "!.env.*": "deny"
    },
    "glob": "allow",
    "grep": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny"
    },
    "bash": {
      "ls *": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git ref*": "allow",
      "git log*": "allow",
      "find *": "allow",
      "head *": "allow",
      "sort *": "allow",
      "cat *": "allow",
      "tail *": "allow",
      "wc *": "allow"
    },
    "skill": "allow",
    "todowrite": "allow"
  }
}

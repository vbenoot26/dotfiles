#!/bin/bash

get_vol() {
    pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | awk '{print $5}' | sed 's/%//'
}

is_muted() {
    pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -q yes
}

case $BLOCK_BUTTON in
    1) pactl set-sink-mute @DEFAULT_SINK@ toggle >/dev/null 2>&1 ;;
    4) pactl set-sink-volume @DEFAULT_SINK@ +5% >/dev/null 2>&1 ;;
    5) pactl set-sink-volume @DEFAULT_SINK@ -5% >/dev/null 2>&1 ;;
esac

vol=$(get_vol)
if is_muted; then
    echo " ${vol}%"
    echo " ${vol}%"
    echo "#F38BA8"
else
    echo " ${vol}%"
fi
